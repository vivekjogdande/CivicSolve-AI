# ==============================================================================
# CivicSolve AI — Frontend Environment Configuration
# ==============================================================================
# In local development:
# Leaving this unset uses Vite's proxy (configured in vite.config.js to http://localhost:5001).
# Or set explicitly:
# VITE_API_URL=http://localhost:5001

# In production deployment (e.g. Vercel, Netlify, Render Static Site):
# Set VITE_API_URL in your hosting service's Environment Variables settings before building:
VITE_API_URL=https://civicsolve-ai-ccwc.onrender.com

