# ==============================================================================
# CivicSolve AI — Backend Environment Configuration Example
# Copy this file to .env and adjust the values for your local or production setup.
# DO NOT COMMIT YOUR REAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# --- Server ---
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://civic-solve-ai-eight.vercel.app

# --- Database (Local MongoDB or MongoDB Atlas Cluster) ---
MONGODB_URI=mongodb://127.0.0.1:27017/CivicSolveDB
# Atlas connection example:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/CivicSolveDB?retryWrites=true&w=majority

# --- Authentication & Session Security ---
# Generate a secure 64-character secret using:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
JWT_EXPIRES_IN=2h

# --- Initial Administrator Account (Used by `npm run seed`) ---
ADMIN_NAME=CivicSolve System Administrator
ADMIN_EMAIL=admin@civicsolve.gov
ADMIN_PASSWORD=change_me_before_seeding_123

# --- Civic Complaint Lifecycle & Evidence Settings ---
RESOLUTION_CONFIRMATION_DAYS=7
EVIDENCE_RADIUS_METERS=100
MAX_UPLOAD_SIZE_MB=10

# --- Local AI Engine Integration (Ollama Vision / LLaVA) ---
# CivicSolve AI uses a resilient multi-tier AI approach:
# 1. Local Ollama LLM / LLaVA (if running on port 11434)
# 2. Heuristic Rule Engine (instant offline-safe fallback)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=llava
OLLAMA_TIMEOUT_MS=15000
OLLAMA_AUTO_COMPARE=true
