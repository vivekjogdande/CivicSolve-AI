# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database (local MongoDB or MongoDB Atlas) ---
MONGODB_URI=mongodb://127.0.0.1:27017/RiverCareDB
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/RiverCareDB?retryWrites=true&w=majority

# --- Auth ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=2h

# --- First administrator (used only by `npm run seed`) ---
ADMIN_NAME=RiverCare Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_before_seeding_1

# --- Verified resolution ---
RESOLUTION_CONFIRMATION_DAYS=7
EVIDENCE_RADIUS_METERS=100

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10

# --- Ollama (local vision model, no paid API key) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=llava
OLLAMA_TIMEOUT_MS=120000
# Set to false to compare images only when an officer clicks the button
OLLAMA_AUTO_COMPARE=true
